AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=app5sCWXMPQpuJodj

# From the Slack app's "OAuth & Permissions" page (starts with xoxb-)
SLACK_BOT_TOKEN=
# From the Slack app's "Basic Information" > App-Level Tokens page (starts with xapp-, needs the connections:write scope)
SLACK_APP_TOKEN=

# Raw bearer key the rpi-job-scheduler print server expects (it only stores this key's SHA-256 hash, in its own .env as JOB_SCHEDULER_API_KEY_HASH)
PRINT_SERVER_API_KEY=
# Base URL of the rpi-job-scheduler Express server (local testing: http://localhost:3000; once co-located on the RPi, its Tailscale address)
PRINT_SERVER_URL=

# Comma-separated Slack member IDs allowed to trigger print jobs (find yours via Slack profile -> "..." -> Copy member ID). Empty means nobody is authorized.
AUTHORIZED_USER_IDS=
